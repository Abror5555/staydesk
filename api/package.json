{
  "name": "staydesk-api",
  "version": "1.0.0",
  "private": true,
  "description": "StayDesk REST API - hotel reservations backend (Node.js, Express, PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "supertest": "7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ]
  }
}
